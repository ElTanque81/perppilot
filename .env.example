# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Leave empty on first start: message the bot and it replies with your chat id.
TELEGRAM_CHAT_ID=

# --- dreamDEX (Somnia Tokyo / Hideki testnet) ------------------------------
NETWORK=hideki
# Recommended: a NEW key used only by this bot, linked to your app account
# with "Link a bot" (it can trade, but never withdraw). Needs a little STT for gas.
PRIVATE_KEY=
# Your DreamDEX account (the wallet you use in the app). Leave empty to trade
# the PRIVATE_KEY's own account instead.
OWNER_ADDRESS=

# true = log orders only. Set to false to send real testnet orders.
DRY_RUN=true

# --- Safety ------------------------------------------------------------------
# Largest notional a single /long or /short may open.
MAX_NOTIONAL_USDSO=200
# How far past the best price a market order may fill, in bps (30 = 0.3%).
SLIPPAGE_BPS=30

# --- Margin guard ---------------------------------------------------------------
# off | alert | auto   (auto trims and flattens by itself)
GUARD_MODE=alert
GUARD_WARN_BELOW=2
GUARD_REDUCE_BELOW=1.5
GUARD_FLATTEN_BELOW=1.15
GUARD_REDUCE_PCT=25
GUARD_POLL_MS=30000
